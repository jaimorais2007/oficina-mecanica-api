# Este Secret nao e versionado no git (contem credenciais reais).
# Copie para secrets.yaml, preencha os valores e aplique manualmente:
#
#   kubectl apply -f k8s/secrets.yaml
#
# Os valores de ConnectionStrings__DefaultConnection podem ser obtidos via:
#   terraform -chdir=../infra output -raw db_connection_string
apiVersion: v1
kind: Secret
metadata:
  name: oficina-mecanica-api-secret
type: Opaque
stringData:
  ConnectionStrings__DefaultConnection: "Host=<rds_endpoint>;Port=5432;Database=oficina_db;Username=oficina_admin;Password=<senha>"
  Jwt__Secret: "<chave-super-secreta-minimo-32-caracteres>"
  EmailSettings__Password: "<senha_de_app_do_email>"
