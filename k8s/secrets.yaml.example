# Este Secret nao e versionado no git (contem credenciais reais).
#
# Forma recomendada de gerar/atualizar (le o .env local automaticamente):
#   ./scripts/generate-k8s-secret.sh
#
# Alternativa manual: copie este arquivo para secrets.yaml, preencha os valores
# (Host=postgres-external, mesmos DB_NAME/DB_USER/DB_PASSWORD do seu .env) e aplique:
#   kubectl apply -f k8s/secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: oficina-mecanica-api-secret
type: Opaque
stringData:
  ConnectionStrings__DefaultConnection: "Host=postgres-external;Port=5432;Database=oficina_db;Username=postgres;Password=<senha_do_.env>"
  Jwt__Secret: "<mesmo_valor_de_JWT_SECRET_no_.env>"
  EmailSettings__Password: "<mesmo_valor_de_EMAIL_PASSWORD_no_.env>"
